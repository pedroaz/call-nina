{
  "name": "@call-nina/offline-runtime",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Optional pinned offline artifacts and owned local inference transport.",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./download": {
      "types": "./dist/download.d.ts",
      "default": "./dist/download.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "default": "./dist/files.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "artifacts": "pnpm run build && node ../../scripts/dev/offline-artifacts.mjs"
  },
  "dependencies": {
    "@call-nina/learning-workflows": "workspace:*",
    "zod": "catalog:",
    "@call-nina/contracts": "workspace:*"
  }
}
