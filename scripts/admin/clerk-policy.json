{
  "requirements": {
    "identifiers": ["username"],
    "authentication": ["password"],
    "signup": "restricted",
    "nativeApi": true,
    "passwordRecovery": "administrator",
    "organizationSelection": "optional"
  },
  "platformConfig": {
    "auth_username": {
      "used_for_sign_in": true,
      "used_for_sign_up": true,
      "required_for_sign_up": true
    },
    "auth_password": {
      "enabled": true,
      "required": true
    },
    "auth_email": {
      "required_for_sign_up": false,
      "used_for_sign_in": false,
      "used_for_sign_up": false,
      "verify_at_sign_up": false
    },
    "auth_access_control": {
      "sign_up_mode": "restricted"
    },
    "organization_settings": {
      "force_organization_selection": false
    }
  },
  "configuration": "Existing instance only. Authenticate using npx clerk auth login. Set CLERK_APPLICATION_ID in private root .env. Review infra clerk-apply and execute with --yes. Partial authentication patches preserve unrelated settings; Native API and origins are read back separately."
}
