{
  "requirements": {
    "identifiers": ["username"],
    "authentication": ["password"],
    "signup": "public",
    "nativeApi": true,
    "passwordRecovery": "administrator",
    "organizationSelection": "optional"
  },
  "platformConfig": {
    "auth_username": {
      "used_for_sign_in": true,
      "used_for_sign_up": true,
      "required_for_sign_up": true
    },
    "auth_password": {
      "enabled": true,
      "required": true,
      "min_length": 8,
      "min_zxcvbn_strength": 0,
      "require_lowercase": false,
      "require_uppercase": false,
      "require_numbers": false,
      "require_special_char": false,
      "disable_hibp": true,
      "enforce_hibp_on_sign_in": false
    },
    "auth_email": {
      "required_for_sign_up": false,
      "used_for_sign_in": false,
      "used_for_sign_up": false,
      "verify_at_sign_up": false
    },
    "auth_access_control": {
      "sign_up_mode": "public"
    },
    "organization_settings": {
      "force_organization_selection": false
    }
  },
  "configuration": "Existing instance only. Authenticate using npx clerk@4.1.0 auth login. Set CLERK_APPLICATION_ID in private root .env. Review infra clerk-apply and execute with --yes. Partial authentication patches preserve unrelated settings; Native API and origins are read back separately."
}
