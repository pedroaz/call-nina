{
  "name": "call-nina",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first companion for learning English, Portuguese, Spanish, and German, with optional Codex integration.",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=26.5.0 <27",
    "pnpm": ">=11.0.9 <12"
  },
  "scripts": {
    "setup": "node scripts/build/setup.mjs",
    "setup:build": "node scripts/build/setup.mjs --profile build",
    "clean": "node scripts/build/clean.mjs",
    "build": "pnpm --filter @call-nina/desktop run build",
    "dev": "node scripts/dev/lifecycle.mjs start dev",
    "start": "node scripts/dev/lifecycle.mjs start prd",
    "status": "node scripts/dev/lifecycle.mjs status",
    "kill": "pnpm run stop",
    "logs": "node scripts/dev/lifecycle.mjs logs",
    "toolchain:check": "node scripts/diagnostics/check-toolchain.mjs",
    "toolchain:check:integration": "node scripts/diagnostics/check-toolchain.mjs --require-codex",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:design-tokens": "node scripts/build/generate-design-tokens.mjs --check",
    "check:versions": "node scripts/diagnostics/check-versions.mjs",
    "check": "pnpm run check:versions && pnpm run check:design-tokens && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "doctor": "node scripts/diagnostics/doctor.mjs",
    "generate:third-party-notices": "node scripts/build/generate-third-party-notices.mjs",
    "package:appimage": "pnpm run generate:third-party-notices && pnpm run build:mcp-helper && pnpm --filter @call-nina/desktop run build && pnpm --filter @call-nina/desktop run package:appimage && node scripts/build/inspect-package.mjs appimage",
    "build:mcp-helper": "node scripts/build/build-mcp-helper.mjs",
    "plugin:install": "node scripts/diagnostics/check-toolchain.mjs --require-codex && pnpm --filter @call-nina/plugin run plugin:install",
    "plugin:refresh": "node scripts/diagnostics/check-toolchain.mjs --require-codex && pnpm --filter @call-nina/plugin run plugin:refresh",
    "plugin:status": "pnpm --filter @call-nina/plugin run plugin:status",
    "plugin:uninstall": "node scripts/diagnostics/check-toolchain.mjs --require-codex && pnpm --filter @call-nina/plugin run plugin:uninstall",
    "package:local": "node scripts/build/package-local.mjs",
    "package:inspect": "node scripts/build/inspect-package.mjs",
    "build:workspace": "pnpm --recursive --workspace-concurrency=1 --if-present run build",
    "stop": "node scripts/dev/lifecycle.mjs stop",
    "design-tokens": "node scripts/build/generate-design-tokens.mjs",
    "package:website": "node scripts/build/package-website.mjs",
    "install:local": "sh install/install.sh install",
    "update:local": "sh install/install.sh update",
    "install:status": "sh install/install.sh status",
    "uninstall:local": "sh install/install.sh uninstall"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tslib": "2.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.67.0",
    "yaml": "catalog:"
  },
  "license": "SEE LICENSE IN LICENSE"
}
