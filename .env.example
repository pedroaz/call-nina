# Copy to .env, keep it private (chmod 600 .env), and fill in existing resources.
# Admin commands load .env automatically. No shell sourcing is needed.
CLERK_SECRET_KEY=
# Authentication settings use the session from npx clerk auth login.
# Existing application app_ ID from npx clerk apps list.
CLERK_APPLICATION_ID=
CLERK_INSTANCE_ID=
# The HTTPS Frontend API origin shown by Clerk, not https://api.clerk.com.
CLERK_ISSUER_URL=
CLERK_PUBLISHABLE_KEY=

VERCEL_TOKEN=
# Existing Neon database from Vercel Marketplace. Reuse its supplied parameters.
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Generated once by explicit runtime-setup, separate from PGPASSWORD.
# Owner/runtime URLs are derived in memory, not duplicated in this file.
NINA_DATABASE_RUNTIME_PASSWORD=

# Inference remains disabled until separately configured and funded.
NINA_STARTER_GATEWAY_API_KEY=
NINA_STARTER_THROTTLE_HMAC_KEY=
