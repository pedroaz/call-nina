{
  "name": "@call-nina/mobile",
  "version": "0.4.1",
  "private": true,
  "description": "The minimal Call Nina Expo application.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "pnpm --filter @call-nina/design-system run build && expo start --go",
    "android": "pnpm --filter @call-nina/design-system run build && expo run:android",
    "ios": "pnpm --filter @call-nina/design-system run build && expo run:ios",
    "build": "pnpm --filter @call-nina/design-system run build && tsc -b && expo export --platform all",
    "config": "expo config --type public",
    "check:dependencies": "expo install --check"
  },
  "dependencies": {
    "@call-nina/design-system": "workspace:*",
    "expo": "57.0.31",
    "expo-build-properties": "57.0.22",
    "expo-font": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "@call-nina/mobile-sync": "workspace:*",
    "@call-nina/contracts": "workspace:*",
    "@clerk/expo": "4.14.4",
    "expo-sqlite": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-crypto": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.22",
    "i18next": "26.3.6",
    "react-i18next": "17.0.11",
    "lucide-react-native": "1.33.0",
    "react-native-svg": "15.15.4",
    "@call-nina/learning-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react-dom": "19.2.3",
    "typescript": "catalog:"
  }
}
